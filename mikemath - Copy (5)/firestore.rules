rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================
    // HELPER FUNCTIONS
    // ===========================
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isOwner() { return isRole('owner'); }
    function isMod() { return isAdmin() || isRole('moderator'); }
    function isEditor() { return isMod() || isRole('editor'); }
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    // Check chính chủ document
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function canLikeProblem() {
      return isAuthenticated()
        && request.resource.data.title == resource.data.title
        && request.resource.data.content == resource.data.content
        && request.resource.data.solution == resource.data.solution
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        // chỉ cho thay đổi likes và likedBy
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0;
    }
    function getMinScoreToCreate() {
      return get(/databases/$(database)/documents/settings/system).data.minScoreCreateProblem;
    }
    function getUserScore() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.totalScore;
    }

    // ===========================
    // ADAPTIVE COURSE ENGINE & ROADMAP SYSTEM
    // ===========================
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /courseLessons/{lessonId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /userCourseState/{stateId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMod());
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isMod());
      allow delete: if isMod();
    }

    match /userKnowledge/{ukId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isMod());
      allow delete: if isMod();
    }

    // ===========================
    // KNOWLEDGE TREE SYSTEM
    // ===========================
    match /knowledgeFolders/{folderId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /knowledgeArticles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Legacy Knowledge Collection
    match /knowledge/{knowledgeId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // ===========================
    // SETTINGS & GLOBAL
    // ===========================
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===========================
    // REPORTS & MODERATION QUEUE
    // ===========================
    match /reports/{reportId} {
      allow read, write: if isMod();
      allow create: if isAuthenticated();
    }

    // ===========================
    // ADMIN LOGS & ANALYTICS
    // ===========================
    match /adminLogs/{logId} {
      allow read: if isMod();
      allow create: if isEditor();
      allow update, delete: if isOwner();
    }

    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    // ===========================
    // RUBRICS & TEMPLATES
    // ===========================
    match /rubrics/{rubricId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    match /rubricTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    // ===========================
    // TOPICS COLLECTION
    // ===========================
    match /topics/{topicId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isEditor();
    }

    // ===========================
    // QR SESSIONS
    // ===========================
    match /qr_sessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() || true;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ===========================
    // PROBLEMS & SUBCOLLECTIONS
    // ===========================
    match /problems/{problemId} {
      allow read: if true;
      allow create: if isAuthenticated() && getUserScore() >= getMinScoreToCreate();
      allow update: if isEditor() || canLikeProblem() || (isAuthenticated() && request.resource.data.diff(resource.data).changedKeys().hasOnly(["views"])) || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isMod() || (isAuthenticated() && request.auth.uid == resource.data.authorId);
      }
    }

    // Global Root Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isMod() || (isAuthenticated() && request.auth.uid == resource.data.authorId);
    }

    // ===========================
    // SUBMISSIONS
    // ===========================
    match /submissions/{submissionId} {
      allow read: if isMod() || (isAuthenticated() && request.auth.uid == resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if isMod() || isAdmin();
    }

    // ===========================
    // USER BEST SCORES
    // ===========================
    match /user_problems/{userProblemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow delete: if isMod();
    }

    // ===========================
    // USERS COLLECTION
    // ===========================
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isMod() || isUser(userId);
      allow delete: if isOwner();
    }

    match /{path=**}/comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isMod() || (isAuthenticated() && request.auth.uid == resource.data.authorId);
    }

    // ===========================
    // FALLBACK CATCH-ALL
    // ===========================
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
